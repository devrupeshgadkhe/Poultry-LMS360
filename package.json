{
  "name": "poultry-lms-360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "launch.cjs",
  "description": "Poultry LMS 360 Desktop Application",
  "author": "Poultry LMS 360 Team",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "start-local": "node start-local.cjs",
    "clean": "rm -rf dist poultry360.db dist-desktop",
    "lint": "tsc --noEmit",
    "electron:compile": "electron compile-bytecode.cjs",
    "electron:dev": "npm run build && npm run electron:compile && electron .",
    "electron:pack": "npm run build && npm run electron:compile && node scripts/codesign.cjs && electron-builder && node scripts/codesign.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bytenode": "^1.5.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "^0.19.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "sqlite3": "^5.1.7",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sqlite3": "^3.1.11",
    "autoprefixer": "^10.4.21",
    "electron": "30.1.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.poultrylms360.app",
    "productName": "Poultry LMS 360",
    "icon": "assets/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "highestAvailable",
      "publisherName": "Poultry Systems International LLC",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Poultry LMS 360",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Poultry LMS 360"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "launch.cjs",
      "main.cjs",
      "main.jsc",
      "package.json",
      "node_modules/**/*",
      "!src/**/*",
      "!server/**/*",
      "!server.ts",
      "!tsconfig.json",
      "!vite.config.ts"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ]
  }
}
