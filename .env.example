# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_DRIVE_REFRESH_TOKEN: Pre-configured refresh token for headless automated Cloud Backups.
# If configured, the system will automatically authenticate and stream daily backups to Google Drive.
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_EMAIL="automated-backup@example.com"

# BACKUP_ENCRYPTION_KEY: Custom passphrase/key used to encrypt SQLite JSON backups (AES-256-CBC).
# If empty, a secure system default key is used.
BACKUP_ENCRYPTION_KEY=""

# GITHUB_BACKUP_PAT: GitHub Personal Access Token with repo scope permissions.
# Required for headless automated backups to GitHub repositories.
GITHUB_BACKUP_PAT=""

# GITHUB_BACKUP_REPO: GitHub repository path where backups will be stored (e.g., "username/repo-name").
GITHUB_BACKUP_REPO=""

# GITHUB_BACKUP_BRANCH: GitHub repository branch name (optional, defaults to "main").
GITHUB_BACKUP_BRANCH="main"

# SUPABASE_URL & ANON_KEY: Cloud database connectivity
VITE_SUPABASE_URL="https://vrujjlytlbjezesupoxq.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_y7TO_O4yXG54m-czqOkvNQ_KlqyVaBN"

